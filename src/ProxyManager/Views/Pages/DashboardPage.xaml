<Page x:Class="ProxyManager.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="仪表盘" ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent" PreviewMouseWheel="OnScrollPreviewMouseWheel">
        <StackPanel Margin="24,16,24,24" MaxWidth="880">

            <!-- 分流总开关 -->
            <ui:Card HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding SubStatusText}" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ApiHealthText}" Margin="0,5,0,0" Opacity="0.55" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EngineOn, Mode=TwoWay}"
                                     IsEnabled="{Binding CanToggle}"
                                     FontSize="15" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </ui:Card>

            <ui:InfoBar IsOpen="{Binding ErrorOpen, Mode=TwoWay}"
                        Title="分流运行异常"
                        Message="{Binding ErrorMessage}"
                        Severity="Error"
                        Margin="0,12,0,0" />

            <!-- 速度统计 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Card HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TUN 总下载（含直连）" HorizontalAlignment="Center" Opacity="0.6" FontSize="12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DownSpeedText}" FontSize="18" FontWeight="SemiBold" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
                <ui:Card HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Column="2" Padding="0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TUN 总上传（含直连）" HorizontalAlignment="Center" Opacity="0.6" FontSize="12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <ui:SymbolIcon Symbol="ArrowUpload24" Foreground="#34D399" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UpSpeedText}" FontSize="18" FontWeight="SemiBold" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
                <ui:Card HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Column="4" Padding="0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="代理连接数" HorizontalAlignment="Center" Opacity="0.6" FontSize="12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <ui:SymbolIcon Symbol="PlugConnected24" Foreground="#FBBF24" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProxiedCountText}" FontSize="18" FontWeight="SemiBold" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- 走代理的连接 -->
            <TextBlock Text="当前走代理的连接" FontSize="15" FontWeight="SemiBold" Margin="2,20,0,8" />
            <ui:Card HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0">
                <Grid>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="18,12,18,4" Opacity="0.55">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" SharedSizeGroup="c1" />
                                    <ColumnDefinition Width="*" SharedSizeGroup="c2" />
                                    <ColumnDefinition Width="90" SharedSizeGroup="c3" />
                                    <ColumnDefinition Width="90" SharedSizeGroup="c4" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="应用" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="目标" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="上传" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="下载" FontSize="12" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Connections}" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="18,5,18,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" SharedSizeGroup="c1" />
                                                <ColumnDefinition Width="*" SharedSizeGroup="c2" />
                                                <ColumnDefinition Width="90" SharedSizeGroup="c3" />
                                                <ColumnDefinition Width="90" SharedSizeGroup="c4" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Process}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Process}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Host}" Opacity="0.8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Host}" />
                                            <TextBlock Grid.Column="2" Text="{Binding UpBytes, StringFormat={}{0:0.##} B}" Opacity="0.7" />
                                            <TextBlock Grid.Column="3" Text="{Binding DownBytes, StringFormat={}{0:0.##} B}" Opacity="0.7" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="18,12" Opacity="0.5" Text="启用分流并使用所选应用后，这里会显示通过代理的连接" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connections.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>

