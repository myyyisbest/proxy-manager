<Page x:Class="ProxyManager.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="设置" ScrollViewer.CanContentScroll="False">
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent" PreviewMouseWheel="OnScrollPreviewMouseWheel">
        <StackPanel Margin="24,16,24,24" MaxWidth="860" HorizontalAlignment="Stretch">

            <!-- 代理服务器 -->
            <TextBlock Text="代理服务器" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,8" />
            <ui:Card HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="所选应用的流量会被转发到这个代理（通常是本机或局域网内的 Clash / V2Ray 混合端口）"
                               Opacity="0.6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="服务器地址" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="127.0.0.1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="端口" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="7890" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="协议" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="{Binding ProxyTypeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="SOCKS5" />
                                <ComboBoxItem Content="HTTP" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="用户名（可选）" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="密码（可选）" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
                            <ui:PasswordBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="增强域名解析" IsChecked="{Binding UseFakeIpDns, Mode=TwoWay}" Margin="0,14,0,0" />
                    <TextBlock Text="仅在本地 DNS 导致应用走代理仍打不开网站时开启。会接管 DNS；企业内网或其他 VPN 建议关闭。修改后点击应用设置。"
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button Content="应用设置" Appearance="Primary" Command="{Binding ApplyProxyCommand}" />
                        <ui:Button Content="测试连接" Appearance="Secondary" Margin="10,0,0,0" Command="{Binding TestConnectionCommand}" />
                        <ui:Button Content="取消测试" Appearance="Secondary" Margin="10,0,0,0" Command="{Binding CancelTestCommand}" IsEnabled="{Binding IsBusy}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ApplyResult}" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.75" />
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding TestResult}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestOk}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 通用 -->
            <TextBlock Text="通用" FontSize="18" FontWeight="SemiBold" Margin="2,20,0,8" />
            <ui:Card HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="20,10">
                <StackPanel>
                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="界面主题" FontWeight="SemiBold" />
                            <TextBlock Text="夜间 / 日间 / 跟随系统，切换立即生效" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                        <ComboBox HorizontalAlignment="Right" MinWidth="120" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="夜间模式" />
                            <ComboBoxItem Content="日间模式" />
                            <ComboBoxItem Content="跟随系统" />
                        </ComboBox>
                    </Grid>
                    <Separator Opacity="0.15" />
                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="开机自启动" FontWeight="SemiBold" />
                            <TextBlock Text="登录 Windows 后自动运行本软件" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AutoStart, Mode=TwoWay}" />
                    </Grid>
                    <Separator Opacity="0.15" />
                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="启动时自动开启分流" FontWeight="SemiBold" />
                            <TextBlock Text="打开软件后立即按规则开始分流" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AutoEngine, Mode=TwoWay}" />
                    </Grid>
                    <Separator Opacity="0.15" />
                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="关闭窗口时最小化到托盘" FontWeight="SemiBold" />
                            <TextBlock Text="从托盘菜单“退出”才会真正退出" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding MinimizeTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 引擎 -->
            <TextBlock Text="分流引擎" FontSize="18" FontWeight="SemiBold" Margin="2,20,0,8" />
            <ui:Card HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="20,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="内核文件" Opacity="0.7" FontSize="12" />
                            <TextBlock Text="{Binding EnginePathText}" FontSize="12" Margin="0,4,0,10"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding EnginePathText}" />
                            <TextBlock Text="内核版本" Opacity="0.7" FontSize="12" />
                            <TextBlock Text="{Binding EngineVersion}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="打开数据目录" Appearance="Secondary" VerticalAlignment="Top"
                                   Command="{Binding OpenDataFolderCommand}" />
                    </Grid>
                    <TextBlock Text="引擎基于开源项目 sing-box（GPL-3.0），本软件只把它用作流量分流器。"
                               Opacity="0.45" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- 关于 -->
            <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" Margin="2,20,0,8" />
            <ui:Card HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="应用代理管理器" FontWeight="SemiBold" />
                    <TextBlock Text="按应用分流网络流量：勾选的应用走代理，其余应用直连，全程不修改 Windows 系统代理设置。"
                               Opacity="0.6" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="提示：创建虚拟网卡需要管理员权限。系统 DNS 和内网保持直连；启用分流时，直连流量也可能经过虚拟网卡，企业 VPN 请先验证兼容性。"
                               Opacity="0.45" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>

