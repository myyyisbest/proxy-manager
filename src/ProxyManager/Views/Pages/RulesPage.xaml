<Page x:Class="ProxyManager.Views.Pages.RulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:v="clr-namespace:ProxyManager.Views"
      Title="应用规则" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <v:FirstLetterConverter x:Key="FirstLetter" />
        <v:EmptyToVisibilityConverter x:Key="EmptyToVis" />
    </Page.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 添加按钮 -->
        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="应用规则" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SummaryText}" Opacity="0.65" Margin="0,4,12,0" TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="浏览文件…" Margin="0,0,8,0"
                       Appearance="Secondary" Click="OnBrowseFile" />
            <ui:Button Grid.Column="2" Content="＋ 添加应用"
                       Appearance="Primary" Click="OnAddFromRunning" />
        </Grid>

        <!-- 规则列表：列表与空状态互斥显示；ListBox 虚拟化，应用多时也不卡 -->
        <ui:Card Grid.Row="1" Padding="0" Margin="0,14,0,0"
                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <ListBox ItemsSource="{Binding Rules}" BorderThickness="0" Background="Transparent" Margin="0,4,0,4"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding Rules.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=hide}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="18,9,18,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="40" Height="40" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstLetter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Opacity="0.85" />
                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                    <TextBlock Text="{Binding ExePath, TargetNullValue=按进程名匹配}" Opacity="0.55" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                </StackPanel>

                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                 OnContent="走代理" OffContent="直连" VerticalAlignment="Center" Margin="0,0,16,0" />

                                <ui:Button Grid.Column="3" Appearance="Caution" VerticalAlignment="Center"
                                           Click="OnRemoveRule" Tag="{Binding}">
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态：仅当规则列表为空时显示 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                            Visibility="{Binding Rules.Count, Converter={StaticResource EmptyToVis}}">
                    <ui:SymbolIcon Symbol="AppFolder24" FontSize="52" Foreground="#64748B" />
                    <TextBlock Text="还没有添加应用" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="点击右上角“添加应用”，从运行中的程序里选择；&#10;其他应用使用直连出口。"
                               Opacity="0.6" HorizontalAlignment="Center" Margin="0,6,0,0"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
